# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dnd_ferreteria?schema=public"

# --- Auth ---
JWT_SECRET="change-me-jwt-secret"
JWT_EXPIRES_IN="15m"
REFRESH_SECRET="change-me-refresh-secret"
REFRESH_EXPIRES_IN="7d"

# --- Server ---
NODE_ENV="development"
PORT=3000
HOST="0.0.0.0"

# --- Images (Cloudflare R2 / S3-compatible) ---
# If unset, the storage adapter falls back to DB BLOB.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
